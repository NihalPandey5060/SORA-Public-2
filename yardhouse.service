[Unit]
Description=YardHouse Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/workspace/server
Environment="PATH=/workspace/server/.venv/bin"
ExecStart=/workspace/server/.venv/bin/gunicorn \
  -k uvicorn.workers.UvicornWorker \
  -w 4 \
  -b 127.0.0.1:8086 \
  main:app
Restart=always

[Install]
WantedBy=multi-user.target
