:80 {
	# REST APIs
	handle /api/* {
		reverse_proxy localhost:8086
	}

	# WebSockets
	handle /ws/* {
		reverse_proxy localhost:8086
	}

	# Frontend (React / static files)
	handle {
		root * ./client/dist
		file_server
	}

	# Generated media files
	handle_path /media/* {
		root * ./media
		file_server
	}
}
